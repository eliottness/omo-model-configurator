{
  // Synthetic OMO configuration used by the README walkthrough and the offline
  // matcher tests.
  //
  // Every entry is here because a doc explains why it is interesting. None of it
  // is a recommendation:
  //   claude-opus-4-8         a clean first-match-wins hit
  //   a/b/GLM-5.3             multi-segment path, and GLM version collapse
  //   gpt-oss-120b            resolves to `fallback` on Sisyphus, yet matches
  //                           `gpt` on the variant surfaces - the two
  //                           mechanisms disagree
  //   gemini-3.5-flash-lite   no Sisyphus branch, so it resolves to `fallback`
  //   unbenchmarked-model     absent from the leaderboard
  "[opencode]": {
    "agents": {
      "planner": {
        "model": "exampleprovider/claude-opus-4-8",
        "reasoning": "high",
      },
      "reviewer": {
        "model": "exampleprovider/gpt-oss-120b",
        "reasoning": "xhigh",
        // `fallback_models` is deprecated in favour of `models`; kept here so
        // the linter has a real finding to report.
        "fallback_models": [
          {
            "model": "exampleprovider/example-org/GLM-5.3",
            "reasoning": "max",
          },
          "exampleprovider/gemini-3.5-flash-lite",
          {
            "model": "exampleprovider/unbenchmarked-model",
            "reasoning": "medium",
          },
        ],
      },
    },
    "categories": {
      "deep": {
        "models": [
          {
            "model": "exampleprovider/claude-opus-4-8",
            "reasoning": "high",
          },
        ],
      },
    },
  },
}
